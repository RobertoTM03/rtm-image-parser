# ---------------------------------------------------------------------------
# LLM models
# ---------------------------------------------------------------------------
# LLM_MODELS is a JSON array — one entry per model *connection* you have
# credentials for. It's wrapped in single quotes so it can span multiple
# lines (dotenv keeps single-quoted values verbatim, including the newlines
# and the double quotes JSON needs — no escaping required). Every entry
# needs:
#
#   id        a label you make up. Used below in EXTRACTION_MODELS and shown
#             in the UI's history/logs. It does NOT need to match any real
#             model or deployment name — "primary", "backup-eu", whatever
#             helps you tell entries apart.
#   provider  "azure" | "openai" | "gemini" — picks which adapter builds the
#             request and which of the fields below are required.
#
# Fields required per provider:
#   azure:  apiKey, endpoint, apiVersion, deployment
#           (deployment = the Azure *deployment* name you gave the model in
#           Azure AI Studio — not the underlying base model name)
#   openai: apiKey, model   (a real OpenAI model name, e.g. "gpt-4o")
#   gemini: apiKey, model   (a real Gemini model name, e.g. "gemini-1.5-pro")
#
# Because every entry carries its own credentials, nothing stops you from
# listing several models from the same provider — e.g. two Azure deployments
# in different regions/resources, each with its own key and endpoint. That's
# what actually enables crosscheck between "the same provider twice": each
# entry is independent, so it's genuinely two different calls, not the same
# deployment invoked under two labels.
#
# One example entry per provider below (one per line) — replace with your
# own, add more of the same provider freely, or delete the ones you don't
# use (and their ids from EXTRACTION_MODELS).
LLM_MODELS='[
  { "id": "azure-primary", "provider": "azure", "apiKey": "", "endpoint": "https://<resource>.openai.azure.com", "apiVersion": "2024-10-21", "deployment": "gpt-4o-prod" },
  { "id": "openai-primary", "provider": "openai", "apiKey": "", "model": "gpt-4o" },
  { "id": "gemini-primary", "provider": "gemini", "apiKey": "", "model": "gemini-1.5-pro" }
]'

# Which of the LLM_MODELS ids above are actually called for each extraction,
# and in what order (comma-separated). Order matters: it's the tie-break
# used when models disagree during crosscheck. Every id here must exist in
# LLM_MODELS above — an id that doesn't is skipped with a startup warning.
EXTRACTION_MODELS=azure-primary,openai-primary,gemini-primary

# Crosscheck
CROSSCHECK_THRESHOLD=0.9
CROSSCHECK_NUMERIC_TOLERANCE=0.01
MAX_RETRIES_PER_MODEL=2

# Timeouts and provider calls
LLM_REQUEST_TIMEOUT_MS=30000

# Input validation
MAX_IMAGE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Skip the by-image-hash result cache and always call the LLMs.
# Set to "false" to disable; anything else keeps caching on.
CACHE_ENABLED=true

# Upper bound on how many extraction logs a client can request per page
# from GET /v1/extraction-logs.
MAX_HISTORY_PAGE_SIZE=50

# Database
DATABASE_URL=postgresql://rtm:rtm@localhost:5432/rtm_image_parser
# Used only by docker-compose to provision the `db` service
POSTGRES_USER=rtm
POSTGRES_PASSWORD=rtm
POSTGRES_DB=rtm_image_parser

# Server
PORT=3000

# Host port the dockerized UI is published on (http://localhost:<UI_PORT>)
UI_PORT=5173
